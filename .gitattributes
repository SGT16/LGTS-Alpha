* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf
*.png binary
*.svg text eol=lf
*.xlsx binary

# Preserve recorded artifacts and exact source snapshots byte for byte.
results/** binary
reproducibility/source_snapshot_*/** binary

# Preserve the byte-level revision manifest on all checkout platforms.
research_revision/** -text
